# Port the Awoken Generator listens on.
PORT=3000
# Directory holding app.db (SQLite) and blobs/ (uploaded images).
# Defaults to ./data relative to where you start the server.
DATA_DIR=./data

# --- Wake pricing (defaults: $5.00 = 20 wakes = $0.25 per wake) ---
PACK_PRICE_CENTS=500
CREDITS_PER_PACK=20
PRICE_PER_WAKE_CENTS=25

# --- Stripe (TEST MODE ONLY) ---
# Create a free Stripe account, stay in test mode, and paste the test keys
# from Developers → API keys. Never use live keys here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Developers → Webhooks → Add endpoint:
#   URL: https://<your-host>/api/stripe/webhook
#   Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
# Public base URL of this deployment (used for Stripe redirects). Leave
# empty for local development; the request host is used instead.
APP_URL=

# --- Workshop lock ---
# When set, the workshop face requires this password and all workshop API
# endpoints require a token from /api/workshop/unlock. When unset, the
# workshop stays open (the server logs a warning at startup).
WORKSHOP_PASSWORD=
